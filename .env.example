# ─────────────────────────────────────────────────────────────────────────────
# LostNFound System — Environment Variables Template
# Copy this file to .env (inside backend/) and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/lostnfound
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=replace_with_64_char_hex_secret
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=2592000000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Production: your actual frontend domain
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Seed admin account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourschool.edu
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Admin

# ── Google OAuth2 ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ── Frontend (.env in frontend/) ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
